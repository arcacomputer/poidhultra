# Copy to an untracked .env. Never use development credentials in production.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
COMMUNITY_API_URL=http://localhost:8787
COMMUNITY_PROXY_KEY=replace-with-a-random-proxy-key
CLIENT_ORIGINS=http://localhost:3000
PROXY_KEYS={"http://localhost:3000":"replace-with-a-random-proxy-key"}
DATABASE_URL=postgresql://poidh:replace-me@localhost:5432/poidh
DATABASE_SCHEMA=poidh_index_v1
POSTGRES_PASSWORD=replace-me
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=poidh-proofs
S3_ACCESS_KEY_ID=replace-with-a-storage-key
S3_SECRET_ACCESS_KEY=replace-with-a-storage-secret
PUBLIC_STORAGE_URL=http://localhost:3000/media
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
MODERATORS=
