{
  "name": "poidhultra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:services": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm test && pnpm test:services && pnpm typecheck",
    "upstream:check": "node scripts/upstream/check.mjs",
    "db:migrate": "node --import tsx packages/database/src/migrate.ts",
    "test:e2e": "playwright test",
    "test:indexer": "node tests/indexer-recovery.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0",
    "viem": "2.56.3",
    "@electric-sql/pglite": "0.5.8"
  },
  "type": "module"
}
